#!/command/with-contenv bash
# Bring the schema to head before the services start, then mirror TZ into
# app_settings for SQL-side consumers (daily_metrics view, Grafana). Runs as
# the dropped user so any state it touches is owned correctly.
set -euo pipefail
cd /app/backend
s6-setuidgid healthlog python -m alembic upgrade head
exec s6-setuidgid healthlog python -m app.db_settings
