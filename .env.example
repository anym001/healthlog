# HealthLog compose configuration. Copy to `.env` (docker compose reads it
# automatically) and set the two required values. Never commit your `.env`.

# --- Required -------------------------------------------------------------

# Password of the `healthlog` database user (any strong random string).
POSTGRES_PASSWORD=

# Shared secret Health Auto Export sends in the X-Ingest-Token header.
# Generate one: openssl rand -hex 32
INGEST_SECRET=

# --- Optional (defaults shown) ---------------------------------------------

# Container clock AND the timezone daily values are computed in (analysis,
# the daily_metrics view, Grafana). Set it to YOUR IANA zone if you are not in
# Central Europe, e.g. America/New_York; otherwise every "day" is shifted.
# `healthlog audit` warns if it doesn't match your data (see README "Configuration").
#TZ=Europe/Vienna

# When the nightly analysis runs (5-field cron, in TZ).
#ANALYSIS_CRON=30 3 * * *

# Host user/group that owns /config (Unraid: 99 / 100).
#PUID=1000
#PGID=1000

# Host directory mounted at /config (config.yaml, import/, narration/, logs).
#CONFIG_DIR=./config

# Pin production to a fixed release, e.g. 0.2.0 (see README "Image").
#HEALTHLOG_VERSION=latest

# Reverse proxies trusted to set X-Real-IP / X-Forwarded-For for the audit
# client IP (comma-separated IPs/CIDRs, or '*' for all). Empty trusts the
# standard private + loopback ranges — right for the usual "container behind
# a reverse proxy on a private network" setup.
#TRUSTED_PROXIES=

# Gotify/PushBits application token for push notifications (the one notify
# secret; behaviour is configured under `notify:` in config.yaml).
#NOTIFY_TOKEN=

# Expose the Prometheus /metrics endpoint (unauthenticated — trusted networks
# only; see README "Metrics").
#METRICS_ENABLED=false

# Serve the interactive API docs (/docs, /redoc, /openapi.json). Keep off on
# an internet-facing instance; flip on temporarily when exploring the API.
#API_DOCS_ENABLED=false
