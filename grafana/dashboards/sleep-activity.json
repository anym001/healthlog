          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 100 * SUM(rem_h) / NULLIF(SUM(total_sleep_h), 0) AS \"REM\" FROM sleep_nightly WHERE $__timeFilter((sleep_date::timestamp AT TIME ZONE '$tz'))",
